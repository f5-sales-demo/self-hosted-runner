{
  "schema_version": 1,
  "provider": "aws",
  "region": "us-east-1",
  "instance_type": "c6a.8xlarge",
  "runner_label": "xcsh-compute-32-vcpu-density-candidate",
  "candidate_workers": 20,
  "production_workers": 10,
  "rollback_workers": 0,
  "max_concurrency": 2,
  "concurrent_flag_allowed": false,
  "active_candidates": 1,
  "cache_states": ["cold"],
  "qualification": {"matched_pairs": 1, "cache_state": "cold", "source_and_image_frozen": true},
  "required_evidence": [
    "source_commit",
    "runner_image_digest",
    "aws_quota",
    "pod_resources",
    "cloudwatch_node_pressure",
    "cpu_throttling",
    "memory_peak_ratio",
    "disk_io",
    "assignment_delay",
    "restarts",
    "evictions",
    "ooms",
    "manifest_digest",
    "output_inventory"
  ],
  "promotion_gates": {
    "matched_comparisons": 1,
    "byte_identical_output": true,
    "maximum_failures": 0,
    "maximum_ooms": 0,
    "maximum_evictions": 0,
    "maximum_restarts": 0,
    "maximum_memory_ratio": 0.8,
    "node_pressure_allowed": false,
    "typescript_duration_must_decrease": true,
    "critical_path_duration_must_decrease": true
  }
}
