{
  "schema_version": 1,
  "provider": "aws",
  "region": "us-east-1",
  "instance_type": "m6a.4xlarge",
  "production_workers": 0,
  "max_concurrency": 2,
  "concurrent_flag_allowed": false,
  "active_candidates": 1,
  "cache_states": ["cold", "warm"],
  "worker_bounds": {"minimum": 0, "maximum": 32},
  "screening": {"first_probe": 10, "step_improvement_ratio": 0.03, "stop_memory_ratio": 0.75},
  "qualification": {"samples_per_cache_state": 5, "rotating_order": true},
  "required_evidence": [
    "source_commit",
    "runner_image_digest",
    "aws_quota",
    "cloudwatch_node_pressure",
    "cpu_throttling",
    "memory_peak_ratio",
    "disk_io",
    "assignment_delay",
    "restarts",
    "evictions",
    "ooms",
    "output_digest"
  ],
  "promotion_gates": {
    "matched_comparisons": 10,
    "byte_identical_output": true,
    "maximum_failures": 0,
    "maximum_ooms": 0,
    "maximum_evictions": 0,
    "maximum_restarts": 0,
    "maximum_memory_ratio": 0.8,
    "p95_regression_allowed": false,
    "minimum_median_typescript_improvement": 0.2
  }
}
